# ---- required ----
BOT_TOKEN=123456:ABC...            # from @BotFather (a NEW bot, not the binaizleme one)
ADMIN_IDS=111111111                # comma-separated Telegram user IDs

# ---- storage ----
DB_PATH=data/binabot.sqlite3
LOG_DIR=logs
TIMEZONE=Asia/Baku

# ---- monitoring ----
CHECK_INTERVAL_SEC=300             # pause between monitoring cycles
REQUEST_MIN_INTERVAL_SEC=3         # minimum gap between any two Bina.az requests
REQUEST_TIMEOUT_SEC=30
REQUEST_RETRIES=2                  # only for network errors / HTTP 5xx (never for 403/429/522)
SCRAPE_CONCURRENCY=1               # searches fetched in parallel
MAX_PAGES=5                        # paging stops earlier when a page has nothing new
SEED_PAGES=2                       # pages read silently when a search is first seen
NEW_MAX_AGE_DAYS=2                 # older ads that resurface (paid bump) are not "new"
REBASELINE_HOURS=24                # search not read for this long -> silent re-baseline
BLOCK_COOLDOWN_MIN=15              # first pause after 403/429/522 (doubles, max 120)
BINA_PERSISTED_HASH=b781511a943a4d710eefdf811a24dd4ae353e55d836952603ce0b37fde97d073
UNKNOWN_PARAMS=reject              # reject | ignore  (filters the bot cannot translate)

# ---- delivery ----
QUEUE_TTL_HOURS=24                 # queued ads older than this are dropped
QUEUE_RESET_AT_MIDNIGHT=true       # at 00:00 yesterday's leftover queue is dropped
VERIFY_AFTER_MIN=60                # ads queued longer than this are checked to still exist

# ---- schedule (local time) ----
REPORT_HOUR=9                      # daily report to admins
REMINDER_HOUR=10                   # expiry reminders (last 3 days, once a day)
DEFAULT_SUB_DAYS=30

# ---- shown to users after they request a plan ----
PAYMENT_INFO=Ödəniş üçün adminlə əlaqə saxlayın: @your_username
